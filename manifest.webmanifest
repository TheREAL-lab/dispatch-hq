{
  "name": "Dispatch HQ — Texas Gate Dispatch",
  "short_name": "Dispatch HQ",
  "description": "Command HQ, rep calling console, Radar and document kit for Texas Gate Dispatch.",
  "id": "./index.html",
  "start_url": "./index.html?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#141414",
  "theme_color": "#141414",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Command HQ", "url": "./index.html?source=shortcut", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Radar", "url": "./radar.html?source=shortcut", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Document Kit", "url": "./docs.html?source=shortcut", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
